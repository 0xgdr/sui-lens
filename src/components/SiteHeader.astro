---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const nav = [
  { href: '/', label: 'Journey' },
  { href: '/lens', label: 'Lens' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Sui Lens home">
    <span class="brand-symbol" aria-hidden="true">
      <img src="/favicon.svg" alt="" width="42" height="42" />
    </span>
    <span class="brand-copy"><strong>Sui Lens</strong><small>Sui learning for JavaScript developers</small></span>
  </a>
  <nav aria-label="Primary navigation">
    {nav.map((item) => (
      <a
        href={item.href}
        class:list={{ active: item.href === '/' ? currentPath === '/' || currentPath.startsWith('/learn') : currentPath === item.href || currentPath.startsWith(`${item.href}/`) }}
        aria-current={currentPath === item.href ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
    <a
      class="github-link"
      href="https://github.com/0xgdr/sui-lens"
      aria-label="View Sui Lens on GitHub"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path
          fill="currentColor"
          d="M12 1C5.92 1 1 5.92 1 12c0 4.87 3.15 8.98 7.52 10.44.55.1.75-.24.75-.53v-2.07c-3.06.67-3.7-1.3-3.7-1.3-.5-1.27-1.22-1.61-1.22-1.61-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.7-1.48-2.45-.28-5.02-1.22-5.02-5.44 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.3 3.02 1.12A10.5 10.5 0 0 1 12 6.28a10.5 10.5 0 0 1 2.75.37c2.1-1.42 3.02-1.12 3.02-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.23-2.58 5.16-5.03 5.43.4.34.75 1.01.75 2.04v3.05c0 .29.2.64.76.53A11 11 0 0 0 23 12c0-6.08-4.92-11-11-11Z"
        />
      </svg>
    </a>
  </nav>
</header>
